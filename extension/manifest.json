{
  "manifest_version": 3,
  "name": "FocusGuard",
  "version": "0.1.1",
  "description": "Shares your active tab's URL and title with the local FocusGuard desktop app to help detect distractions.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://localhost/*"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ricky.mcriver@gmail.com",
      "strict_min_version": "109.0"
    }
  }
}
