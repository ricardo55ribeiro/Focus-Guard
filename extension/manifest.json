{
  "manifest_version": 3,
  "name": "FocusGuard",
  "version": "0.1.1",
  "description": "AI-powered focus enforcement. Works with the FocusGuard desktop app to monitor your active browser tab and enforce your study sessions.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://localhost/*"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ricky.mcriver@gmail.com",
      "strict_min_version": "109.0"
    }
  }
}
